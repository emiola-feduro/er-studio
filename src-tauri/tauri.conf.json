{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ER Studio ++",
  "version": "../package.json",
  "identifier": "io.github.emiola-feduro.er-studio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ER Studio ++",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Entity-relationship modeling and live databases",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4NDA2NzQzNjQxNkMzNkYKUldSdnd4WmtRMmRBeU9XeTREd005bzBkcTRLS3B3ZmF0VWdHZzBwbEFDdnRTUU5acGRvRTJMZnAK",
      "endpoints": [
        "https://github.com/emiola-feduro/er-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
